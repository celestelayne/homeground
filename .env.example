# Local PostgreSQL. Postgres.app defaults to your macOS username with no
# password. Create the database once with: createdb homeground
DATABASE_URL=postgres://localhost:5432/homeground

# Map tiles. Optional — leave these unset and the map falls back to IGN, which
# needs no credentials. Geocoding is IGN and never needs a key.
#
# Anything named VITE_ is compiled into the browser bundle and is readable by
# anyone who opens the page. That is unavoidable for tile keys: they are
# protected by an HTTP origin restriction set in the provider's account, not by
# being secret. Restrict them there before deploying anything.
VITE_MAPBOX_TOKEN=pk.your-public-mapbox-token
VITE_MAPTILER_KEY=your-maptiler-key

# Server-side, for Mapbox routing from M3. Never sent to the browser.
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token
