{
  "name": "@homeground/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/server.js",
    "ingest:finess": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/finess/run-ingest.js",
    "ingest:density": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/density/run-ingest.js",
    "ingest:georisques": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/georisques/run-ingest.js"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.19.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
